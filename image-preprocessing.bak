    "# Convert images in specified directory to PDF format\n",
    "\n",
    "directory_with_img_inputs = \".astr_clahe\" # Set this to your input directory containing images\n",
    "directory_for_pdf_outputs = \".astr_pdf\" # Set this to your desired output directory for PDFs\n",
    "\n",
    "# Create output directory if it doesn't exist\n",
    "os.makedirs(directory_for_pdf_outputs, exist_ok=True)\n",
    "\n",
    "images_to_pdf(image_folder=directory_with_img_inputs, output_folder=directory_for_pdf_outputs)"
   ]
