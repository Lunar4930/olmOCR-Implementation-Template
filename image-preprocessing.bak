   "source": [
    "import os\n",
    "import cv2\n",
    "import fitz # From PyMuPDF\n",
    "import img2pdf\n",
    "import pytesseract\n",
    "import numpy as np # Required dependency for some image processing steps\n",
    "from PIL import Image"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6d24f95b",
   "metadata": {},
   "source": [
    "# Functions\n",
    "\n",
    "You must run these cells before executing the pipeline below"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "a73ce023",
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_clahe(\n",
    "    image_path,\n",
    "    write_output=False,\n",
    "    output_path=None,\n",
    "    apply_blur=True,\n",
    "    blur_kernel_size=(3, 3),\n",
    "    blur_sigma=0,\n",
    "    apply_clahe_step=True,\n",
    "    clahe_clip_limit=8.0,\n",
    "    clahe_tile_grid_size=(32, 32)\n",
    "):\n",
    "    \"\"\"\n",
    "    Apply optional Gaussian blur and CLAHE to an input image for OCR-style preprocessing.\n",
    "\n",
    "    The function reads an image from disk, converts it to grayscale, optionally applies:\n",
    "    1) Gaussian blur (noise smoothing), and\n",
    "    2) CLAHE (local contrast enhancement).\n",
    "\n",
    "    Optionally, the processed image is written to disk when `write_output=True`.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    image_path : str\n",
    "        Path to the input image file.\n",
    "    write_output : bool, default=False\n",
    "        If True, save the processed image to `output_path`.\n",
    "        If False, no file is written.\n",
    "    output_path : str | None, default=None\n",
    "        Destination path for the processed image. Required when `write_output=True`.\n",
    "    apply_blur : bool, default=True\n",
    "        If True, apply Gaussian blur before CLAHE. This can reduce noise.\n",
    "    blur_kernel_size : tuple[int, int], default=(3, 3)\n",
    "        Gaussian kernel size `(kx, ky)`. Both values must be odd. Larger kernels apply stronger smoothing.\n",
    "    blur_sigma : float, default=0\n",
    "        Gaussian sigma. If 0, OpenCV derives sigma from kernel size.\n",
    "    apply_clahe_step : bool, default=True\n",
    "        Whether to apply CLAHE after blur.\n",
    "    clahe_clip_limit : float, default=8.0\n",
    "        CLAHE clipping threshold controlling contrast amplification. Higher values increase local contrast.\n",
    "    clahe_tile_grid_size : tuple[int, int], default=(32, 32)\n",
    "        CLAHE tile grid size `(cols, rows)`. Samaller tiles increase local contrast effects.\n",
    "\n",
    "    Raises\n",
    "    ------\n",
    "    ValueError\n",
    "        If the image cannot be read from `image_path`.\n",
    "    ValueError\n",
    "        If any blur kernel dimension is even.\n",
    "    ValueError\n",
    "        If `write_output=True` and `output_path` is not provided.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    None\n",
    "        The function performs in-place preprocessing logic and optionally writes\n",
    "        the result to disk.\n",
    "    \"\"\"\n",
    "    img = cv2.imread(image_path)\n",
    "    if img is None:\n",
    "        raise ValueError(f\"Could not read image: {image_path}\")\n",
    "    \n",
    "    # Read the image in grayscale\n",
    "    img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
    "\n",
    "    # Optional blur\n",
    "    if apply_blur:\n",
    "        kx, ky = blur_kernel_size\n",
    "        if kx % 2 == 0 or ky % 2 == 0:\n",
    "            raise ValueError(\"blur_kernel_size values must be odd.\")\n",
    "        img = cv2.GaussianBlur(img, blur_kernel_size, blur_sigma)\n",
    "\n",
    "    # Optional CLAHE\n",
    "    if apply_clahe_step:\n",
    "        clahe = cv2.createCLAHE(\n",
    "            clipLimit=clahe_clip_limit,\n",
    "            tileGridSize=clahe_tile_grid_size\n",
    "        )\n",
    "        img = clahe.apply(img)\n",
    "\n",
    "    if write_output:\n",
    "        if output_path is None:\n",
    "            raise ValueError(\"`output_path` must be provided if `write_output` is True.\")\n",
    "\n",
    "        # Save the processed image to disk\n",
    "        cv2.imwrite(output_path, img)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "5353a325",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pipeline for detecting and correcting document orientation issues, including rotation, upside-down, and mirrored scans.\n",
    "\n",
    "def fix_rotation_by_text_confidence(image):\n",
    "    \"\"\"\n",
    "    Try all 4 rotations, pick the one where OCR gives \n",
    "    the highest confidence or most recognized text.\n",
    "    \"\"\"\n",
    "    best_text_len = 0\n",
    "    best_rotation = 0\n",
    "    \n",
    "    for angle in [0, 90, 180, 270]:\n",
    "        rotated = image.rotate(angle, expand=True)\n",
    "        # Use simple OCR to see which rotation yields the most text\n",
    "        text = pytesseract.image_to_string(rotated, config='--psm 6')\n",
    "        text_len = len(text.strip())\n",
    "        \n",
    "        if text_len > best_text_len:\n",
    "            best_text_len = text_len\n",
    "            best_rotation = angle\n",
    "    \n",
    "    print(f\"Best rotation by OCR confidence: {best_rotation}°\")\n",
    "    return image.rotate(best_rotation, expand=True)\n",
    "\n",
    "\n",
    "def is_mirrored(image):\n",
    "    \"\"\"\n",
    "    Detect if a document is mirrored (scanned backwards).\n",
    "    Compare OCR confidence of normal vs. flipped image.\n",
    "    \"\"\"\n",
    "    normal_text = pytesseract.image_to_data(image, output_type=pytesseract.Output.DICT)\n",
    "    flipped = image.transpose(Image.FLIP_LEFT_RIGHT)\n",
    "    flipped_text = pytesseract.image_to_data(flipped, output_type=pytesseract.Output.DICT)\n",
    "    \n",
    "    # Compare average OCR confidence scores\n",
    "    normal_conf = [c for c in normal_text['conf'] if int(c) > 0]\n",
    "    flipped_conf = [c for c in flipped_text['conf'] if int(c) > 0]\n",
    "    \n",
    "    avg_normal = np.mean(normal_conf) if normal_conf else 0\n",
    "    avg_flipped = np.mean(flipped_conf) if flipped_conf else 0\n",
    "    \n",
    "    print(f\"Normal confidence: {avg_normal:.1f}, Flipped confidence: {avg_flipped:.1f}\")\n",
    "    \n",
    "    # If flipped version has significantly better OCR results, it's mirrored\n",
    "    return avg_flipped > avg_normal + 5  # threshold margin\n",
    "\n",
    "def detect_and_correct_orientation(image_path):\n",
    "    \"\"\"\n",
    "    Detects rotation, upside-down, and mirrored (backwards) documents.\n",
    "    \"\"\"\n",
    "    image = Image.open(image_path)\n",
    "    \n",
    "    # Fix rotation using Tesseract OSD\n",
    "    try:\n",
    "        osd = pytesseract.image_to_osd(image)\n",
    "        rotation = int(osd.split(\"Rotate: \")[1].split(\"\\n\")[0])\n",
    "        confidence = float(osd.split(\"Orientation confidence: \")[1].split(\"\\n\")[0])\n",
    "        \n",
    "        print(f\"Detected rotation: {rotation}°, confidence: {confidence}\")\n",
    "        \n",
    "        if rotation != 0:\n",
    "            image = image.rotate(rotation, expand=True)\n",
    "    except pytesseract.TesseractError:\n",
    "        print(\"OSD failed, trying alternative methods...\")\n",
    "        image = fix_rotation_by_text_confidence(image)\n",
    "    \n",
    "    # Detect if mirrored (backwards scan)\n",
    "    if is_mirrored(image):\n",
    "        print(\"Document appears mirrored — flipping horizontally.\")\n",
    "        image = image.transpose(Image.FLIP_LEFT_RIGHT)\n",
    "    \n",
    "    return image\n",
    "\n",
    "# --- Example Usage ---\n",
    "# corrected = detect_and_correct_orientation(\"scanned_doc.png\")\n",
    "# corrected.save(\"corrected_doc.png\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "d3371708",
   "metadata": {},
   "outputs": [],
   "source": [
    "def pdf_to_images_pymupdf(pdf_path, output_folder):\n",
    "    # Open the PDF document\n",
    "    pdf_document = fitz.open(pdf_path)\n",
    "    \n",
    "    # Iterate through each page\n",
    "    for page_number in range(len(pdf_document)):\n",
    "        page = pdf_document.load_page(page_number)\n",
    "        \n",
    "        # Render the page to an image (pixmap)\n",
    "        # You can increase the resolution by setting a matrix, e.g., fitz.Matrix(2, 2)\n",
    "        pix = page.get_pixmap(matrix=fitz.Matrix(2, 2)) \n",
    "        \n",
    "        # Save the image\n",
    "        output_path = f\"{output_folder}/page_{page_number + 1:04d}.png\"\n",
    "        pix.save(output_path)\n",
    "        # print(f\"Saved: {output_path}\")\n",
    "        \n",
    "    pdf_document.close()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5f78ea11",
   "metadata": {},
   "outputs": [],
   "source": [
    "def images_to_pdf(image_folder, output_folder):\n",
    "    # Get list of image files in the folder\n",
    "    image_files = sorted([f for f in os.listdir(image_folder) if f.lower().endswith(('.png', '.jpg', '.jpeg'))])\n",
    "    \n",
    "    # Create a list of full paths to the images\n",
    "    image_paths = [os.path.join(image_folder, img) for img in image_files]\n",
    "\n",
    "    # Strip any existing extension and force .pdf\n",
    "    for i, img in enumerate(image_files):\n",
    "        output_pdf_path = os.path.join(output_folder, os.path.splitext(img)[0] + \".pdf\")\n",
    "    \n",
    "        # Convert images to PDF\n",
    "        with open(output_pdf_path, \"wb\") as f:\n",
    "            f.write(img2pdf.convert(image_paths[i]))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "be62bc56",
   "metadata": {},
   "source": [
    "# Pipeline\n",
    "\n",
    "Not all of these cells may be needed for you use case or set of images. However, you must convert images to PDF to use olmOCR."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "c6d352a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply CLAHE to image directory\n",
    "\n",
    "directory_with_img_inputs = \".astr\" # Set this to your input directory containing images\n",
    "directory_for_img_outputs = f\"{directory_with_img_inputs}_clahe\"\n",
    "\n",
    "# Create output directory if it doesn't exist\n",
    "os.makedirs(directory_for_img_outputs, exist_ok=True)\n",
    "\n",
    "for filename in os.listdir(directory_with_img_inputs):\n",
    "    if filename.endswith(\".png\") or filename.endswith(\".jpg\") or filename.endswith(\".jpeg\"):\n",
    "        input_path = os.path.join(directory_with_img_inputs, filename)\n",
    "        output_path = os.path.join(directory_for_img_outputs, filename.split(\".\")[0] + \"_clahe.\" + filename.split(\".\")[-1])\n",
    "        apply_clahe(image_path=input_path, write_output=True, output_path=output_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "417c0ae5",
   "metadata": {},
   "outputs": [
