   ],
   "source": [
    "# Apply rotation correction to image directory\n",
    "# NOTE: olmOCR has built-in rotation correction, but this may be useful if that solution is performing poorly or if you have other processing steps that require correctly oriented images.\n",
    "# NOTE: Tesseract's OSD can be unreliable, so this step may not always yield good results, especially for low-quality images.\n",
    "# NOTE: If you have a large number of images, this process can be slow due to the OCR-based orientation detection. Consider running it on a subset of images first to evaluate its effectiveness before applying it to the entire dataset.\n",
    "\n",
    "# Remove the quotes (comment syntax) around the code below to run it.\n",
    "\n",
    "\"\"\"\n",
    "directory_with_img_inputs = \".astr_clahe\" # Set this to your input directory containing images\n",
    "directory_for_img_outputs = \".astr_rotated\" # Set this to your desired output directory for corrected images\n",
    "\n",
    "# Create output directory if it doesn't exist\n",
    "os.makedirs(directory_for_img_outputs, exist_ok=True)\n",
    "\n",
    "# Loop through images, detect and correct orientation, and save results\n",
    "for filename in os.listdir(directory_with_img_inputs):\n",
    "    if filename.endswith(\".png\") or filename.endswith(\".jpg\") or filename.endswith(\".jpeg\"):\n",
    "        input_path = os.path.join(directory_with_img_inputs, filename)\n",
    "        output_path = os.path.join(directory_for_img_outputs, filename.split(\".\")[0] + \"_corrected.\" + filename.split(\".\")[-1])\n",
    "        corrected_image = detect_and_correct_orientation(input_path)\n",
    "        corrected_image.save(output_path)\n",
    "\"\"\""
   ]
